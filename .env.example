# Copy to .env and fill in. Never commit your real .env.

# Required — API key for your LLM provider (any OpenAI-compatible endpoint).
# Gemini (free, high limits): https://aistudio.google.com/app/apikey
# Groq (free, fast):          https://console.groq.com/keys
# GitHub Models (free):       https://github.com/settings/personal-access-tokens/new (Models: Read)
LLM_API_KEY=

# OpenAI-compatible base URL for the provider. Examples:
#   Gemini:         https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:           https://api.groq.com/openai/v1
#   GitHub Models:  https://models.github.ai/inference
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model id for that provider. Examples:
#   Gemini:         gemini-2.0-flash
#   Groq:           llama-3.3-70b-versatile
#   GitHub Models:  openai/gpt-4o-mini
LLM_MODEL=gemini-2.0-flash

# GitHub PAT for server-side GitHub API calls (raises limit from 60/hr to 5000/hr).
# Create at https://github.com/settings/tokens — no scopes needed for public repos.
GITHUB_TOKEN=

# Optional — local dev API port (default: 3001)
# API_PORT=3001
