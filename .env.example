# Copy to .env and fill in. Never commit your real .env.

# Required — Google Gemini API key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional — override the model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional — local dev API port (default: 3001)
# API_PORT=3001
